{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite",
            "rewrites": [
                {
                    "source": "/(.*)",
                    "destination": "/index.html"
                }
            ]
        },
        "backend": {
            "root": "backend",
            "entrypoint": "app.main:app"
        },
        "demo_target": {
            "root": "demo-target",
            "entrypoint": "app:app"
        },
        "dummy_agent_target": {
            "root": "dummy-agent-target",
            "entrypoint": "app:app"
        }
    },
    "rewrites": [
        {
            "source": "/api(/.*)?",
            "destination": {
                "type": "service",
                "service": "backend"
            }
        },
        {
            "source": "/demo(/.*)?",
            "destination": {
                "type": "service",
                "service": "demo_target"
            }
        },
        {
            "source": "/dummy-agent(/.*)?",
            "destination": {
                "type": "service",
                "service": "dummy_agent_target"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ]
}
