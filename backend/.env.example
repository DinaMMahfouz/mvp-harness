# Supabase Postgres — use the Supavisor TRANSACTION POOLER connection string, not the
# "Direct connection" host. The direct host (db.<ref>.supabase.co) is IPv6-only and will
# fail to resolve on many networks/containers (confirmed locally); the pooler host is
# normal IPv4 and is also what Render needs anyway (its containers can't hold long-lived
# direct PG connections well). Get the exact string from: Supabase dashboard -> harness-mvp
# project -> Project Settings -> Database -> Connection string -> "Transaction pooler".
DATABASE_URL=postgresql://postgres.adzaoqmdapyvtxeayrlt:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://adzaoqmdapyvtxeayrlt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (semantic evaluation)
ANTHROPIC_API_KEY=

# n8n automation
N8N_WEBHOOK_URL=
HARNESS_WEBHOOK_SECRET=

# CORS
CORS_ORIGINS=http://localhost:5173

ENV=development
